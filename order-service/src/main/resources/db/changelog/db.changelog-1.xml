<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="CREATE_ORDER" author="yefrosiniya.zinkovskaya">
        <createTable tableName="orders">
            <column name="id" type="${type.bigint}" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="${type.string}"/>
            <column name="price" type="${type.numeric}"/>
        </createTable>
    </changeSet>

    <changeSet id="INSERT_ORDER" author="yefrosiniya.zinkovskaya">
        <insert tableName="orders">
            <column name="status" value="PENDING"/>
            <column name="price" valueNumeric="1000"/>
        </insert>
    </changeSet>
</databaseChangeLog>